# =============================================================================
# OPROX Real Estate — Required Environment Variables
# Copy to .env and fill in real values before starting any service.
# Never commit .env to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# API Server (artifacts/realestate-api)
# -----------------------------------------------------------------------------

# PORT: HTTP port the API server listens on. REQUIRED — server refuses to start
# without a valid port.
PORT=8099

# NODE_ENV: Set to "production" in production deployments. Controls CORS mode,
# error verbosity, and DB connection SSL.
NODE_ENV=development

# DATABASE_URL: PostgreSQL connection string. Required for persistent data.
# Format: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/oprox_realestate

# ALLOWED_ORIGIN / APP_URL: In production (NODE_ENV=production), CORS is
# restricted to this origin. Use your real domain.
ALLOWED_ORIGIN=https://your-domain.com
APP_URL=https://your-domain.com

# -----------------------------------------------------------------------------
# AI — Gemini (required for AI Concierge, property search, valuation)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
# Alternative key name also accepted:
# GOOGLE_API_KEY=your-google-api-key-here

# -----------------------------------------------------------------------------
# AI — OpenAI (required for Layla portal chat assistant)
# -----------------------------------------------------------------------------
# Replit AI Integrations injects this automatically when OpenAI integration is
# connected. For self-hosted deployments, set it manually.
OPENAI_API_KEY=sk-...
# AI_INTEGRATIONS_OPENAI_API_KEY=<injected by Replit AI Integrations>
# AI_INTEGRATIONS_OPENAI_BASE_URL=<optional; overrides the OpenAI base URL>

# -----------------------------------------------------------------------------
# AI — Tripo3D (required for 3D model generation in AI Architect)
# -----------------------------------------------------------------------------
TRIPO3D_API_KEY=your-tripo3d-api-key-here
# Alternative key name also accepted:
# TRIPO_KEY=your-tripo3d-api-key-here

# -----------------------------------------------------------------------------
# Email (required for lead welcome emails via Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_...
# Sender address shown in outgoing emails. Defaults to onboarding@resend.dev
# if not set (Resend test domain — always set this in production).
SENDER_EMAIL=OPROX Properties <noreply@your-domain.com>

# -----------------------------------------------------------------------------
# File storage (optional — used for generated video media)
# -----------------------------------------------------------------------------
# WORKSPACE_ROOT: Absolute path to the workspace root. Defaults to cwd().
# Used to locate attached_assets/generated_videos/*.mp4 served via /media.
# WORKSPACE_ROOT=/home/user/oprox-real-estate

# -----------------------------------------------------------------------------
# Replit-specific (injected automatically in Replit deployments)
# -----------------------------------------------------------------------------
# REPLIT_DOMAINS: Comma-separated list of allowed domains for sitemap generation.
# REPLIT_DOMAINS=your-repl.replit.app
