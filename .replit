modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8099
externalPort = 8099

[[ports]]
localPort = 14320
externalPort = 80

[[ports]]
localPort = 19855
externalPort = 3000

[[ports]]
localPort = 26232
externalPort = 3001

[[ports]]
localPort = 26233
externalPort = 3002

[userenv]

[userenv.development]
DEV_STATIC_OTP = "000000"
