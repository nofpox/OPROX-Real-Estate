{
  "expo": {
    "name": "Razzor MSREP",
    "slug": "rkz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rkz",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1628"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rkz.app"
    },
    "android": {
      "package": "com.rkz.app"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://property-dashboard-nofabark.replit.app/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Razzor MSREP needs access to your photos to add property images.",
          "cameraPermission": "Razzor MSREP needs your camera to take property photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Razzor MSREP uses your location to auto-fill the property address."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/rkz"
    }
  }
}
