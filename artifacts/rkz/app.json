{
  "expo": {
    "name": "Housin",
    "slug": "rozoz-msrep",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/rozoz-icon.png",
    "scheme": "rozoz-msrep",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/rozoz-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F2040"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.housin.app",
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["uber", "bolt", "careem"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/rozoz-icon.png",
        "backgroundColor": "#0F2040"
      },
      "package": "com.housin.app",
      "intentFilters": []
    },
    "web": {
      "favicon": "./assets/images/rozoz-icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://property-dashboard-nofabark.replit.app/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Housin تحتاج للوصول إلى صورك لإضافة صور العقارات.",
          "cameraPermission": "Housin تحتاج الكاميرا لالتقاط صور العقارات."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Housin تستخدم موقعك لتعبئة عنوان العقار تلقائياً."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/rozoz-msrep"
    }
  }
}
